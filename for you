  <script>

    /* =========================
       CHANGE YOUR PIN HERE
    ========================= */

    const correctPIN = "0708";

    let enteredPIN = "";

    const dots = document.querySelectorAll(".pin-dot");
    const error = document.getElementById("error");

    function pressKey(number) {

      if (enteredPIN.length >= 4) return;

      enteredPIN += number;

      updateDots();

      if (enteredPIN.length === 4) {

        setTimeout(() => {

          if (enteredPIN === correctPIN) {

            document.getElementById("lockScreen").style.display = "none";
            document.getElementById("main").style.display = "block";

            createHearts();

          } else {

            error.textContent = "hmm... that's not the number ♡";

            enteredPIN = "";

            setTimeout(() => {
              error.textContent = "";
              updateDots();
            }, 900);

          }

        }, 250);

      }

    }


    function deleteKey() {

      enteredPIN = enteredPIN.slice(0, -1);

      error.textContent = "";

      updateDots();

    }


    function updateDots() {

      dots.forEach((dot, index) => {

        if (index < enteredPIN.length) {
          dot.classList.add("active");
        } else {
          dot.classList.remove("active");
        }

      });

    }


    /* =========================
       COUNTDOWN
       CHANGE THIS DATE
    ========================= */

    const startDate = new Date("2026-05-06T00:00:00");

    function updateCountdown() {

      const now = new Date();

      const difference = now - startDate;

      if (difference < 0) return;

      const seconds = Math.floor(difference / 1000);

      const days = Math.floor(seconds / 86400);
      const hours = Math.floor((seconds % 86400) / 3600);
      const minutes = Math.floor((seconds % 3600) / 60);
      const secs = seconds % 60;

      document.getElementById("days").textContent = days;
      document.getElementById("hours").textContent = hours;
      document.getElementById("minutes").textContent = minutes;
      document.getElementById("seconds").textContent = secs;

    }

    updateCountdown();

    setInterval(updateCountdown, 1000);


    /* =========================
       LOVE SLIDER
    ========================= */

    const loveSlider = document.getElementById("loveSlider");
const loveValue = document.getElementById("loveValue");
const loveMessage = document.getElementById("loveMessage");

function updateLoveSlider() {
  const value = Number(loveSlider.value);

  loveValue.textContent = value;

  if (value <= 20) {
    loveMessage.textContent = "hmm... is this even love?";
  } else if (value <= 40) {
    loveMessage.textContent = "okay, maybe a little...";
  } else if (value <= 60) {
    loveMessage.textContent = "wait, i'm starting to like you";
  } else if (value <= 80) {
    loveMessage.textContent = "okay, i really really like you";
  } else if (value < 100) {
    loveMessage.textContent = "you're becoming my favorite person";
  } else {
    loveMessage.textContent = "100% sure, it's always you ♡";
  }
}

loveSlider.addEventListener("input", updateLoveSlider);

updateLoveSlider();

    /* =========================
       MUSIC
    ========================= */


