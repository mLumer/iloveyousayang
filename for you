<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>for you ♡</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: #fffaf8;
      color: #473b3a;
      font-family: "DM Sans", sans-serif;
      overflow-x: hidden;
    }

    button,
    input {
      font-family: inherit;
    }

    /* =========================
       FLOATING HEARTS
    ========================= */

    .heart {
      position: fixed;
      bottom: -30px;
      color: #e7a7ad;
      font-size: 15px;
      pointer-events: none;
      animation: floatUp linear forwards;
      opacity: .6;
      z-index: 20;
    }

    @keyframes floatUp {
      from {
        transform: translateY(0) rotate(0deg);
        opacity: 0;
      }

      15% {
        opacity: .6;
      }

      to {
        transform: translateY(-110vh) rotate(25deg);
        opacity: 0;
      }
    }

    /* =========================
       PIN SCREEN
    ========================= */

    #lockScreen {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 30px;
      background:
        radial-gradient(circle at 20% 20%, #ffe8eb 0, transparent 28%),
        radial-gradient(circle at 80% 80%, #f9e4dc 0, transparent 30%),
        #fffaf8;
    }

    .lock-card {
      width: min(420px, 100%);
      text-align: center;
      padding: 45px 28px;
      border-radius: 32px;
      background: rgba(255,255,255,.72);
      border: 1px solid rgba(220,170,175,.25);
      box-shadow: 0 25px 80px rgba(130, 87, 88, .12);
      backdrop-filter: blur(15px);
    }

    .tiny {
      font-size: 12px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #ad8588;
      margin-bottom: 15px;
    }

    .lock-card h1 {
      font-family: "Playfair Display", serif;
      font-size: 42px;
      font-weight: 400;
      margin-bottom: 10px;
      color: #4c3b3c;
    }

    .lock-card p {
      color: #967e80;
      font-size: 14px;
      line-height: 1.7;
      margin-bottom: 28px;
    }

    .pin-display {
      height: 35px;
      display: flex;
      justify-content: center;
      gap: 13px;
      margin-bottom: 25px;
    }

    .pin-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      border: 1px solid #d49da3;
      transition: .2s;
    }

    .pin-dot.active {
      background: #d49da3;
    }

    .keypad {
      display: grid;
      grid-template-columns: repeat(3, 65px);
      justify-content: center;
      gap: 12px;
    }

    .key {
      width: 65px;
      height: 55px;
      border: 0;
      border-radius: 18px;
      background: #fff;
      color: #604b4c;
      font-size: 17px;
      cursor: pointer;
      box-shadow: 0 5px 18px rgba(130,87,88,.08);
      transition: .15s;
    }

    .key:hover {
      transform: translateY(-2px);
      background: #fff0f1;
    }

    .key:active {
      transform: scale(.94);
    }

    .key.delete {
      font-size: 15px;
      color: #a78386;
    }

    .error {
      height: 20px;
      margin-top: 18px;
      color: #c77980;
      font-size: 12px;
    }

    /* =========================
       MAIN
    ========================= */

    #main {
      display: none;
    }

    .hero {
      min-height: 100vh;
      padding: 90px 25px 70px;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      position: relative;
      background:
        radial-gradient(circle at 10% 20%, #ffe8eb, transparent 28%),
        radial-gradient(circle at 90% 70%, #f8e5dd, transparent 30%),
        #fffaf8;
    }

    .hero-content {
      max-width: 720px;
    }

    .hero .tiny {
      margin-bottom: 20px;
    }

    .hero h1 {
      font-family: "Playfair Display", serif;
      font-size: clamp(48px, 10vw, 88px);
      line-height: 1;
      font-weight: 400;
      color: #493b3b;
      margin-bottom: 25px;
    }

    .hero h1 span {
      font-style: italic;
      color: #c88e95;
    }

    .hero p {
      max-width: 470px;
      margin: auto;
      color: #927b7d;
      line-height: 1.8;
      font-size: 15px;
    }

    .scroll {
      position: absolute;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 12px;
      color: #a98e91;
      letter-spacing: 2px;
      animation: bounce 2s infinite;
    }

    @keyframes bounce {
      50% {
        transform: translate(-50%, 8px);
      }
    }

    section {
      padding: 100px 22px;
      max-width: 1050px;
      margin: auto;
    }

    .section-label {
      text-align: center;
      color: #bd8d92;
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 11px;
      margin-bottom: 12px;
    }

    .section-title {
      text-align: center;
      font-family: "Playfair Display", serif;
      font-size: clamp(35px, 6vw, 55px);
      font-weight: 400;
      margin-bottom: 12px;
    }

    .section-subtitle {
      text-align: center;
      color: #947d7e;
      font-size: 14px;
      line-height: 1.8;
      max-width: 550px;
      margin: 0 auto 50px;
    }

    /* =========================
       COUNTDOWN
    ========================= */

    .countdown {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      max-width: 700px;
      margin: auto;
      gap: 15px;
    }

    .time-box {
      padding: 25px 10px;
      border-radius: 24px;
      background: #fff;
      box-shadow: 0 12px 35px rgba(120,80,80,.07);
    }

    .time-box strong {
      display: block;
      font-family: "Playfair Display", serif;
      font-size: 38px;
      font-weight: 400;
      color: #654f50;
    }

    .time-box span {
      font-size: 11px;
      color: #aa9294;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    /* =========================
       MEMORIES
    ========================= */

    .memories {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    .memory {
      position: relative;
      height: 360px;
      border-radius: 25px;
      overflow: hidden;
      cursor: pointer;
      background: #eadbd7;
    }

    .memory img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: .6s;
    }

    .memory:hover img {
      transform: scale(1.05);
    }

    .memory-overlay {
      position: absolute;
      inset: auto 0 0;
      padding: 25px;
      color: white;
      background: linear-gradient(transparent, rgba(45,30,30,.75));
    }

    .memory-overlay h3 {
      font-family: "Playfair Display", serif;
      font-size: 23px;
      font-weight: 400;
    }

    .memory-overlay p {
      font-size: 12px;
      opacity: .85;
      margin-top: 5px;
    }

    /* =========================
       LOVE REASONS
    ========================= */

    .reasons {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .reason {
      padding: 28px 22px;
      border-radius: 25px;
      background: #fff;
      box-shadow: 0 12px 35px rgba(120,80,80,.06);
      transition: .3s;
    }

    .reason:hover {
      transform: translateY(-5px);
    }

    .reason-number {
      color: #d09ca2;
      font-size: 12px;
      margin-bottom: 15px;
    }

    .reason h3 {
      font-family: "Playfair Display", serif;
      font-size: 23px;
      font-weight: 400;
      margin-bottom: 9px;
    }

    .reason p {
      color: #907b7c;
      line-height: 1.7;
      font-size: 13px;
    }

    /* =========================
       LOVE SLIDER
    ========================= */

    .love-box {
      max-width: 700px;
      margin: auto;
      padding: 45px 25px;
      border-radius: 30px;
      background: #fff;
      text-align: center;
      box-shadow: 0 15px 45px rgba(120,80,80,.07);
    }

    .love-number {
      font-family: "Playfair Display", serif;
      font-size: 65px;
      color: #bd8d92;
      margin-bottom: 10px;
    }

    .love-number span {
      font-size: 30px;
    }

    .love-box input[type="range"] {
      width: 100%;
      accent-color: #d49da3;
      cursor: pointer;
    }

    .slider-note {
      color: #9c8587;
      font-size: 12px;
      margin-top: 18px;
    }

    /* =========================
       SOUNDTRACK
    ========================= */

    /* =========================
       LETTER
    ========================= */

    .letter-wrapper {
      display: flex;
      justify-content: center;
    }

    .letter {
      width: min(650px, 100%);
      background: #fff;
      padding: 45px 35px;
      border-radius: 25px;
      box-shadow: 0 15px 50px rgba(120,80,80,.08);
      cursor: pointer;
      transition: .4s;
      position: relative;
    }

    .letter:hover {
      transform: translateY(-5px) rotate(.3deg);
    }

    .letter-front {
      text-align: center;
    }

    .letter-front .envelope {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .letter-front h3 {
      font-family: "Playfair Display", serif;
      font-size: 30px;
      font-weight: 400;
    }

    .letter-front p {
      color: #9a8586;
      font-size: 13px;
      margin-top: 10px;
    }

    .letter-content {
      display: none;
      line-height: 1.9;
      color: #735f60;
      font-size: 14px;
    }

    .letter.open .letter-front {
      display: none;
    }

    .letter.open .letter-content {
      display: block;
      animation: fadeIn .5s;
    }

    .letter-content h3 {
      font-family: "Playfair Display", serif;
      font-size: 30px;
      font-weight: 400;
      margin-bottom: 20px;
    }

    .letter-content p {
      margin-bottom: 17px;
    }

    .signature {
      font-family: "Playfair Display", serif;
      font-style: italic;
      font-size: 22px;
      margin-top: 25px;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    footer {
      text-align: center;
      padding: 50px 20px 80px;
      color: #a58d8f;
      font-size: 12px;
    }

    footer span {
      color: #cc949b;
    }

    /* =========================
       RESPONSIVE
    ========================= */

    @media (max-width: 700px) {

      section {
        padding: 75px 18px;
      }

      .countdown {
        grid-template-columns: repeat(2, 1fr);
      }

      .memories {
        grid-template-columns: 1fr;
      }

      .memory {
        height: 400px;
      }

      .reasons {
        grid-template-columns: 1fr;
      }

      .song {
        padding: 15px;
      }

      .hero h1 {
        font-size: 58px;
      }

      .letter {
        padding: 35px 25px;
      }
    }
  </style>
</head>

